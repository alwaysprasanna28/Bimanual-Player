<?xml version="1.0"?>
<package format="2">
  <name>fr3_bimanual_trajectory_player</name>
  <version>0.1.0</version>
  <description>Plays JSON joint trajectories for a bimanual Franka FR3 setup.</description>
  <maintainer email="prasannakukade28@gmail.com">User</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>actionlib</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3</exec_depend>
</package>
